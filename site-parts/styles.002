.lesson-header h1 { font-size: clamp(34px, 4vw, 52px); }
.lesson-summary { color: var(--muted); font-size: 17px; max-width: 760px; }
.objectives { margin-top: 22px; padding: 16px 18px; background: var(--surface-2); border-radius: 12px; border: 1px solid var(--line); }
.objectives strong { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
.objectives ul { margin: 10px 0 0; padding-left: 20px; color: #53606c; line-height: 1.75; font-size: 14px; }
.lesson-section { max-width: 820px; padding: 34px 0; border-bottom: 1px solid var(--line); }
.lesson-section p { color: #46535f; }
.formula { margin-top: 16px; padding: 15px 18px; border-left: 3px solid var(--accent); background: var(--accent-soft); font-family: "SFMono-Regular", Consolas, monospace; font-size: 14px; overflow: auto; }
.source-list { display: grid; gap: 9px; margin-top: 14px; }
.source-card { display: flex; justify-content: space-between; gap: 18px; align-items: center; padding: 13px 14px; border: 1px solid var(--line); border-radius: 11px; text-decoration: none; background: var(--surface-2); }
.source-card:hover { border-color: #b9c5cd; }
.source-card span { color: var(--muted); font-size: 12px; }
.learning-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }

.context-panel { padding: 30px 24px; border-left: 1px solid var(--line); background: #fbfcfd; position: sticky; top: 66px; align-self: start; min-height: calc(100vh - 66px); }
.context-panel .context-label { color: var(--muted); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.context-panel h3 { margin-top: 11px; }
.context-panel p { color: var(--muted); font-size: 13px; }
.evidence-badge { display: inline-flex; margin-top: 8px; padding: 5px 8px; background: var(--accent-soft); color: var(--accent-2); border-radius: 7px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
.code-path { display: block; margin-top: 15px; padding: 10px; background: #eef1f3; border-radius: 8px; font-size: 10px; word-break: break-all; line-height: 1.5; text-decoration: none; }

.lab-panel { max-width: 880px; }
.lab-toolbar { display: flex; gap: 8px; margin: 14px 0; flex-wrap: wrap; }
.code-editor { width: 100%; min-height: 300px; resize: vertical; border: 1px solid #cbd4db; border-radius: 12px; background: #10161c; color: #e8f0f4; padding: 18px; line-height: 1.55; font-size: 13px; tab-size: 4; }
.code-editor:focus { outline: 3px solid rgba(23,107,135,.18); border-color: var(--accent); }
.runtime-status { min-height: 22px; color: var(--muted); font-size: 12px; margin: 8px 0; }
.output { min-height: 110px; white-space: pre-wrap; padding: 16px; border-radius: 12px; background: #111820; color: #dbe7ed; font-size: 13px; overflow: auto; }
.fallback { margin-top: 14px; padding: 15px 16px; border: 1px solid #e2c788; background: var(--warning-soft); border-radius: 11px; color: #6d510f; }
.expected { margin-top: 18px; padding: 16px; border: 1px dashed #bbc7cf; border-radius: 11px; background: var(--surface-2); }
.expected pre { white-space: pre-wrap; color: #4d5a65; }

.quiz-form { max-width: 820px; }
.question { padding: 22px 0; border-bottom: 1px solid var(--line); }
.question fieldset { border: 0; padding: 0; margin: 0; }
.question legend { font-weight: 760; margin-bottom: 12px; line-height: 1.5; }
.option { display: flex; align-items: flex-start; gap: 9px; padding: 10px 12px; margin: 5px 0; border: 1px solid var(--line); border-radius: 10px; color: #4b5864; }
.option:hover { background: var(--surface-2); }
.option input { margin-top: 3px; }
.quiz-result { margin: 24px 0; padding: 18px; border: 1px solid #c9e3d3; background: var(--success-soft); border-radius: 13px; }
.quiz-result strong { font-size: 24px; }
.explanations { margin-top: 12px; color: #4c5a53; font-size: 13px; }

.reference-wrap { max-width: 1100px; margin: 0 auto; padding: 50px 28px 90px; }
.reference-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 28px; }
.ref-card { padding: 20px; background: white; border: 1px solid var(--line); border-radius: 15px; }
.ref-card dl { margin: 0; }
.ref-card dt { font-weight: 780; margin-top: 16px; }
.ref-card dd { margin: 5px 0 0; color: var(--muted); line-height: 1.6; }
.ref-list { padding-left: 18px; color: var(--muted); line-height: 1.7; }
.ref-list a { color: var(--accent-2); }

.roadmap-toggle { display: none; }
.mobile-roadmap { display: none; }
.empty-state { padding: 80px 24px; text-align: center; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

@media (max-width: 1120px) {
  .learning-shell { grid-template-columns: 235px minmax(0, 1fr) 250px; }
  .module-grid { grid-template-columns: repeat(2, 1fr); }
  .header-boundary { display: none; }
}
@media (max-width: 899px) {
  .site-header { padding: 0 15px; gap: 10px; }
  .brand span:last-child { display: none; }
  .top-nav { gap: 0; overflow-x: auto; }
  .top-nav a { padding: 8px 9px; font-size: 12px; white-space: nowrap; }
  .learning-shell { display: block; }
  .roadmap, .context-panel { display: none; }
  .lesson-main { padding: 25px 20px 80px; }
  .roadmap-toggle { display: inline-flex; margin: 0 0 18px; }
  .mobile-roadmap.open { display: block; position: fixed; inset: 66px 0 0 0; z-index: 50; background: rgba(13,22,29,.44); }
  .mobile-roadmap-inner { width: min(88vw, 360px); height: 100%; overflow: auto; background: white; padding: 20px; box-shadow: var(--shadow); }
  .mobile-roadmap .roadmap { display: block; position: static; height: auto; border: 0; background: white; padding: 0; }
  .mobile-context { display: block; margin-top: 28px; padding: 18px; background: #f4f8fa; border: 1px solid var(--line); border-radius: 12px; }
  .metric-row { grid-template-columns: 1fr; }
  .dashboard { padding: 34px 18px 70px; }
}
@media (min-width: 900px) { .mobile-context { display: none; } }
@media (max-width: 620px) {
  .module-grid, .reference-grid { grid-template-columns: 1fr; }
  .module-card { min-height: 180px; }
  h1 { font-size: 36px; }
  .dashboard-intro { font-size: 16px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
